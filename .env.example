SQUARE_ACCESS_TOKEN=your_square_access_token
SQUARE_APPLICATION_ID=your_square_application_id
SQUARE_LOCATION_ID=your_square_location_id
SQUARE_ENV=production
PORT=3000
# Existing Stripe endpoint in server.js (required for server.js to start)
STRIPE_SECRET_KEY=your_stripe_secret_key

# Magazine inquiry form storage (see docs/magazine/FORMS-AND-STORAGE.md)
INQUIRY_SHEETS_WEBHOOK_URL=
INQUIRY_SHEETS_WEBHOOK_SECRET=
# Local development only: save inquiries to .data/magazine-inquiries.jsonl
# INQUIRY_DEV_STORE=file
